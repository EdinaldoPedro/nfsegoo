{
  "name": "emissor-nfse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-with-worker.cjs",
    "dev:web": "next dev",
    "dev:full": "node scripts/dev-with-worker.cjs",
    "build": "next build",
    "start": "next start",
    "worker:compile": "tsc -p tsconfig.worker.json",
    "worker:typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "worker:start": "node -r ./scripts/register-worker.cjs dist/worker/workers/emission-worker.js",
    "worker:local": "node --env-file=.env -r ./scripts/register-worker.cjs dist/worker/workers/emission-worker.js",
    "worker:documents:local": "node --env-file=.env -r ./scripts/register-worker.cjs dist/worker/workers/document-worker.js",
    "worker:documents:start": "node -r ./scripts/register-worker.cjs dist/worker/workers/document-worker.js",
    "worker:consultations:start": "node scripts/supervise-consultations.cjs",
    "worker:consultations:local": "node scripts/supervise-consultations.cjs --local",
    "release:build": "node scripts/build-release.cjs",
    "release:manifest": "node scripts/release-artifact.cjs --write",
    "readiness:release": "node --env-file=.env scripts/release-artifact.cjs",
    "readiness:infrastructure": "node --env-file=.env scripts/infrastructure-readiness.cjs",
    "monitor:operational": "node --env-file=.env scripts/operational-monitor.cjs",
    "legal:fingerprint": "node scripts/legal-governance-readiness.cjs --fingerprint",
    "readiness:legal": "node --env-file=.env scripts/legal-governance-readiness.cjs",
    "readiness:capacity": "node --env-file=.env scripts/capacity-readiness.cjs",
    "readiness:acceptance": "node --env-file=.env scripts/manual-acceptance-readiness.cjs",
    "readiness:public-launch": "node --env-file=.env scripts/public-launch-readiness.cjs",
    "test:danfse": "node -r ./scripts/register-typescript-tests.cjs --test app/services/pdf/DanfseGenerator.test.cjs",
    "test:unit": "node scripts/run-tests.cjs unit",
    "test:integration": "node --env-file=.env scripts/run-tests.cjs integration",
    "typecheck": "tsc --noEmit --incremental false",
    "fiscal:fingerprint": "node -r ./scripts/register-typescript-tests.cjs scripts/fiscal-homologation-readiness.cjs --fingerprint",
    "readiness:fiscal": "node --env-file=.env -r ./scripts/register-typescript-tests.cjs scripts/fiscal-homologation-readiness.cjs",
    "readiness:migrations": "node --env-file=.env scripts/migration-gate.cjs",
    "readiness:production": "node --env-file=.env -r ./scripts/register-typescript-tests.cjs scripts/production-readiness.cjs",
    "studio": "node node_modules/prisma/build/index.js studio",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.6",
    "@xmldom/xmldom": "0.8.15",
    "axios": "1.20.0",
    "bcryptjs": "^3.0.3",
    "jose": "^5.10.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "jszip": "^3.10.1",
    "libxml2-wasm": "0.7.1",
    "lucide-react": "^0.562.0",
    "next": "16.3.4",
    "node-forge": "1.4.0",
    "nodemailer": "9.1.1",
    "playwright": "1.62.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@tailwindcss/postcss": "^4",
    "@types/jszip": "^3.4.0",
    "@types/node": "24.13.3",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.18.1"
  },
  "packageManager": "npm@12.0.2",
  "prisma": {
    "seed": "npx ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
