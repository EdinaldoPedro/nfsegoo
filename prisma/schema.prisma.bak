enum Role {
  MASTER
  ADMIN
  SUPORTE
  SUPORTE_TI
  CONTADOR
  COMUM
}

enum StatusNota {
  RASCUNHO
  PROCESSANDO
  AUTORIZADA
  ERRO
  CANCELADA
}
