generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                      @id @default(uuid())
  email                    String                      @unique
  senha                    String
  sessionVersion           Int                         @default(0)
  customerPortalGrantedAt  DateTime?
  customerPortalGrantedById String?
  customerPortalRevokedAt  DateTime?
  mfaSecret                String?
  mfaPendingSecret         String?
  mfaPendingExpires        DateTime?
  mfaEnabledAt             DateTime?
  mfaRecoveryCodes         String?
  mfaLastUsedStep          Int                         @default(-1)
  nome                     String
  role                     Role                        @default(COMUM)
  cpf                      String?                     @unique
  telefone                 String?
  plano                    String?                     @default("GRATUITO")
  planoCiclo               String                      @default("MENSAL")
  planoStatus              String                      @default("active")
  planoExpiresAt           DateTime?
  cargo                    String?
  avatarUrl                String?
  resetToken               String?                     @unique
  resetExpires             DateTime?
  darkMode                 Boolean                     @default(false)
  idioma                   String                      @default("pt-BR")
  notificacoesEmail        Boolean                     @default(true)
  ipOrigem                 String?
  lastLoginAt              DateTime?
  empresaId                String?                     @unique
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  privacyErasedAt          DateTime?
  tempEmail                String?                     @unique
  verificationCode         String?
  verificationExpires      DateTime?
  limiteEmpresas           Int                         @default(5)
  tutorialStep             Int                         @default(0)
  creditosPlano            Int                         @default(0)
  creditosExtras           Int                         @default(0)
  dataRenovacaoCiclo       DateTime?
  empresasContabeis        ContadorVinculo[]           @relation("ContadorUser")
  pedidos                  Pedido[]
  historicoPlanos          PlanHistory[]
  ticketsAtendidos         Ticket[]                    @relation("AtendenteTicket")
  ticketsCriados           Ticket[]                    @relation("SolicitanteTicket")
  mensagensTicket          TicketMensagem[]
  empresa                  Empresa?                    @relation("DonoEmpresa", fields: [empresaId], references: [id])
  clientes                 UserCliente[]
  empresasAdicionais       Int                         @default(0)
  empresasFaturadas        Empresa[]                   @relation("FaturamentoEmpresa")
  empresasCustodiadas      Empresa[]                   @relation("CustodiaEmpresa")
  empresasProprietarias    Empresa[]                   @relation("ProprietarioEmpresa")
  eventosCrm               UserEvent[]
  faturas                  Fatura[]
  cuponsUsados             CupomLog[]
  pedidoAnexos             PedidoAnexo[]
  impersonacoesIniciadas   ImpersonationSession[]      @relation("ImpersonationActor")
  impersonacoesRecebidas   ImpersonationSession[]      @relation("ImpersonationTarget")
  sessoes                  AuthSession[]
  creditReservations       EmissionCreditReservation[]
  ownershipInitiated       CompanyOwnershipRequest[]   @relation("OwnershipInitiator")
  ownershipReceived        CompanyOwnershipRequest[]   @relation("OwnershipRecipient")
  ownershipPrevious        CompanyOwnershipRequest[]   @relation("OwnershipPrevious")
  ownershipPrimary         CompanyOwnershipRequest[]   @relation("OwnershipPrimary")
  ownershipReviewed        CompanyOwnershipRequest[]   @relation("OwnershipReviewer")
  ownershipConsents        CompanyOwnershipConsent[]
  passwordResetRequests    PasswordResetRequest[]
  legalAcceptances         LegalAcceptance[]
  privacyRequests          PrivacyRequest[]            @relation("PrivacyRequestSubject")
  privacyRequestsResolved  PrivacyRequest[]            @relation("PrivacyRequestResolver")
  securityIncidentsCreated SecurityIncident[]          @relation("SecurityIncidentCreator")
  securityIncidentsUpdated SecurityIncident[]          @relation("SecurityIncidentUpdater")
  mfaLoginChallenges       MfaLoginChallenge[]
  trustedDevices           MfaTrustedDevice[]
  entidadeFiscalCorrecoes  EntidadeFiscalCorrecao[]    @relation("EntidadeFiscalCorrecaoAutor")
  entidadeFiscalEventos    EntidadeFiscalEvento[]      @relation("EntidadeFiscalEventoAutor")
}

model MfaLoginChallenge {
  id                 String    @id @default(uuid())
  tokenHash          String    @unique
  userId             String
  emailCodeHash      String?
  emailCodeExpiresAt DateTime?
  emailCodeSentAt    DateTime?
  attempts           Int       @default(0)
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model MfaTrustedDevice {
  id            String    @id @default(uuid())
  userId        String
  tokenHash     String    @unique
  method        String
  userAgentHash String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, revokedAt])
  @@index([expiresAt, revokedAt])
}

model PrivacyRequest {
  id                 String    @id @default(uuid())
  userId             String
  type               String
  status             String    @default("PENDENTE")
  description        String?   @db.Text
  identityVerifiedAt DateTime
  dueAt              DateTime
  resolutionSummary  String?   @db.Text
  legalBasis         String?   @db.Text
  resolvedAt         DateTime?
  resolvedById       String?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  subject            User      @relation("PrivacyRequestSubject", fields: [userId], references: [id], onDelete: Restrict)
  resolvedBy         User?     @relation("PrivacyRequestResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([status, dueAt])
  @@index([resolvedById, resolvedAt])
}

model SecurityIncident {
  id                       String    @id @default(uuid())
  protocol                 String    @unique
  title                    String
  category                 String
  severity                 String
  status                   String    @default("DETECTADO")
  summary                  String    @db.Text
  affectedData             String?   @db.Text
  affectedSystems          String?   @db.Text
  affectedSubjectsEstimate Int?
  riskToSubjects           String    @default("DESCONHECIDO")
  riskAssessment           String?   @db.Text
  containmentActions       String?   @db.Text
  decisionRationale        String?   @db.Text
  detectedAt               DateTime
  containedAt              DateTime?
  regulatoryDeadlineAt     DateTime
  notifiedAnpdAt           DateTime?
  notifiedSubjectsAt       DateTime?
  resolvedAt               DateTime?
  retainUntil              DateTime
  createdById              String
  updatedById              String
  version                  Int       @default(1)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  createdBy                User      @relation("SecurityIncidentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                User      @relation("SecurityIncidentUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([status, regulatoryDeadlineAt])
  @@index([severity, detectedAt])
  @@index([retainUntil])
}

model EmailOutbox {
  id                String    @id @default(uuid())
  dedupKey          String    @unique
  recipientHash     String
  payloadEncrypted  String    @db.Text
  status            String    @default("PENDENTE")
  attempts          Int       @default(0)
  maxAttempts       Int       @default(8)
  nextAttemptAt     DateTime  @default(now())
  leaseToken        String?
  leaseUntil        DateTime?
  lastErrorCode     String?
  providerMessageId String?
  sentAt            DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, nextAttemptAt, leaseUntil])
  @@index([expiresAt])
  @@index([recipientHash, createdAt])
}

model AuthSession {
  id             String    @id @default(uuid())
  userId         String
  sessionVersion Int
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  mfaVerifiedAt  DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model RateLimitBucket {
  keyHash   String   @id
  hits      Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model PasswordResetRequest {
  id               String    @id @default(uuid())
  userId           String
  tokenHash        String    @unique
  expiresAt        DateTime
  deliveredAt      DateTime?
  deliveryFailedAt DateTime?
  consumedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, consumedAt, revokedAt])
}

model ImpersonationSession {
  id             String    @id @default(uuid())
  tokenHash      String    @unique
  actorUserId    String
  actorSessionId String?
  targetUserId   String
  mode           String    @default("READ_ONLY")
  reason         String
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  actor          User      @relation("ImpersonationActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  target         User      @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, expiresAt])
  @@index([actorSessionId])
  @@index([targetUserId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model PendingRegistration {
  id                   String   @id @default(uuid())
  email                String   @unique
  senhaHash            String
  nome                 String
  cpf                  String   @unique
  telefone             String?
  role                 Role     @default(COMUM)
  verificationCodeHash String
  verificationExpires  DateTime
  termsVersion         String
  privacyVersion       String
  acceptedAt           DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model LegalAcceptance {
  id             String   @id @default(uuid())
  userId         String
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime
  source         String
  ipAddressHash  String?
  userAgentHash  String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsVersion, privacyVersion])
  @@index([acceptedAt])
}

model Empresa {
  id                           String                    @id @default(uuid())
  documento                    String                    @unique
  ambiente                     String                    @default("PRODUCAO")
  cadastroCompleto             Boolean                   @default(false)
  serieDPS                     String                    @default("900")
  ultimoDPS                    Int                       @default(0)
  email                        String?
  razaoSocial                  String
  nomeFantasia                 String?
  cep                          String?
  logradouro                   String?
  numero                       String?
  complemento                  String?
  bairro                       String?
  cidade                       String?
  uf                           String?
  codigoIbge                   String?
  aliquotaPadrao               Decimal?                  @default(0.00) @db.Decimal(5, 2)
  issRetidoPadrao              Boolean                   @default(false)
  tipoTributacaoPadrao         String?                   @default("1")
  regimeEspecialTributacao     String?                   @default("0")
  inscricaoMunicipal           String?
  regimeTributario             String?
  certificadoA1                String?
  senhaCertificado             String?
  certificadoVencimento        DateTime?
  certificadoCnpj              String?
  certificadoFingerprintSha256 String?
  certificadoValidadoEm        DateTime?
  certificadoChainStatus       String?
  certificadoCnpjSource        String?
  updatedAt                    DateTime                  @updatedAt
  lastApiCheck                 DateTime?
  arquivadoEm                  DateTime?
  arquivadoPor                 String?
  motivoArquivamento           String?
  atividades                   Cnae[]
  contadoresLink               ContadorVinculo[]         @relation("EmpresaContabil")
  notasEmitidas                NotaFiscal[]              @relation("PrestadorNota")
  logs                         SystemLog[]
  donoUser                     User?                     @relation("DonoEmpresa")
  vinculadoA                   UserCliente[]
  ownershipRequests            CompanyOwnershipRequest[]
  vendasRealizadas             Venda[]                   @relation("VendaPrestador")
  sequenciasDps                DpsSequencia[]
  minhaCarteira                VinculoCarteira[]
  clientesCadastrados          Cliente[]
  donoFaturamentoId            String?
  donoFaturamento              User?                     @relation("FaturamentoEmpresa", fields: [donoFaturamentoId], references: [id])
  contadorCustodianteId        String?
  contadorCustodiante          User?                     @relation("CustodiaEmpresa", fields: [contadorCustodianteId], references: [id])
  proprietarioUserId           String?
  proprietarioUser             User?                     @relation("ProprietarioEmpresa", fields: [proprietarioUserId], references: [id])
  modoCobranca                 String                    @default("RESPONSAVEL_UNICO")
  statusPropriedade            String                    @default("ORFA")

  @@index([donoFaturamentoId])
  @@index([contadorCustodianteId])
  @@index([proprietarioUserId])
  @@index([statusPropriedade])
  @@index([certificadoVencimento])
  @@index([certificadoChainStatus])
}

model DpsSequencia {
  id                  String    @id @default(uuid())
  empresaId           String
  ambiente            String
  serie               String
  ultimoConfirmado    Int       @default(0)
  ultimoReservado     Int       @default(0)
  sincronizadoEm      DateTime?
  origem              String    @default("MANUAL")
  statusSincronizacao String    @default("NAO_SINCRONIZADO")
  atualizadoPor       String?
  syncToken           String?
  syncLockedUntil     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  empresa             Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, ambiente, serie])
  @@index([empresaId, ambiente])
}

model Cliente {
  id                 String            @id @default(uuid())
  tipo               String            @default("PJ")
  documento          String?
  empresaId          String?
  entidadeFiscalId   String?
  nome               String
  nomeFantasia       String?
  email              String?
  telefone           String?
  inscricaoMunicipal String?
  inscricaoEstadual  String?
  cep                String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  uf                 String?
  pais               String            @default("Brasil")
  codigoIbge         String?
  semEndereco        Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  arquivadoEm        DateTime?
  arquivadoPor       String?
  motivoArquivamento String?
  moeda              String?           @default("BRL")
  nif                String?
  notas              NotaFiscal[]
  vendas             Venda[]
  vinculos           VinculoCarteira[]
  empresa            Empresa?          @relation(fields: [empresaId], references: [id])
  entidadeFiscal     EntidadeFiscal?   @relation(fields: [entidadeFiscalId], references: [id], onDelete: Restrict)

  @@unique([empresaId, documento])
  @@unique([id, empresaId])
  @@index([empresaId, arquivadoEm, createdAt])
  @@index([entidadeFiscalId])
}

// Identidade cadastral pública e compartilhada de uma pessoa jurídica. Dados
// particulares da relação prestador/tomador permanecem em Cliente.
model EntidadeFiscal {
  id                String                    @id @default(uuid())
  tipo              String                    @default("PJ")
  documento         String                    @unique
  razaoSocial       String
  nomeFantasia      String?
  situacaoCadastral String?
  emailPublico      String?
  telefonePublico   String?
  cep               String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  uf                String?
  pais              String                    @default("Brasil")
  codigoIbge        String?
  fonte             String                    @default("LEGADO")
  fonteConsultadaEm DateTime?
  fontePayloadHash  String?
  version           Int                       @default(1)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  clientes          Cliente[]
  atividades        EntidadeFiscalAtividade[]
  correcoes         EntidadeFiscalCorrecao[]
  eventos           EntidadeFiscalEvento[]

  @@index([razaoSocial])
  @@index([updatedAt])
}

model EntidadeFiscalAtividade {
  id               String         @id @default(uuid())
  entidadeFiscalId String
  codigo           String
  descricao        String?
  principal        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  entidadeFiscal   EntidadeFiscal @relation(fields: [entidadeFiscalId], references: [id], onDelete: Cascade)

  @@unique([entidadeFiscalId, codigo])
  @@index([codigo])
}

model EntidadeFiscalCorrecao {
  id               String         @id @default(uuid())
  entidadeFiscalId String
  campo            String
  valor            String?
  justificativa    String         @db.Text
  actorUserId      String
  version          Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  entidadeFiscal   EntidadeFiscal @relation(fields: [entidadeFiscalId], references: [id], onDelete: Cascade)
  actor            User           @relation("EntidadeFiscalCorrecaoAutor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([entidadeFiscalId, campo])
  @@index([actorUserId, updatedAt])
}

model EntidadeFiscalEvento {
  id               String         @id @default(uuid())
  entidadeFiscalId String
  origem           String
  camposAlterados  String         @db.Text
  snapshotJson     String?        @db.Text
  actorUserId      String?
  createdAt        DateTime       @default(now())
  entidadeFiscal   EntidadeFiscal @relation(fields: [entidadeFiscalId], references: [id], onDelete: Cascade)
  actor            User?          @relation("EntidadeFiscalEventoAutor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entidadeFiscalId, createdAt])
  @@index([actorUserId, createdAt])
}

// Auditable mapping for pre-migration IDs still present in open browser tabs/drafts.
model ClienteTenantMigration {
  originalClienteId String
  empresaId         String
  clienteId         String
  createdAt         DateTime @default(now())

  @@id([originalClienteId, empresaId])
  @@index([clienteId])
}

model VinculoCarteira {
  id                 String    @id @default(uuid())
  empresaId          String
  clienteId          String
  apelido            String?
  tags               String?
  observacoes        String?
  emailFinanceiro    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  arquivadoEm        DateTime?
  arquivadoPor       String?
  motivoArquivamento String?
  cliente            Cliente   @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Cascade)
  empresa            Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, clienteId])
}

model Venda {
  id                 String       @id @default(uuid())
  empresaId          String
  clienteId          String
  valor              Decimal      @db.Decimal(10, 2)
  descricao          String
  status             String       @default("PENDENTE")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  arquivadoEm        DateTime?
  arquivadoPor       String?
  motivoArquivamento String?
  notas              NotaFiscal[]
  logs               SystemLog[]
  cliente            Cliente      @relation(fields: [clienteId, empresaId], references: [id, empresaId])
  empresa            Empresa      @relation("VendaPrestador", fields: [empresaId], references: [id])
}

model NotaRascunho {
  id          String   @id @default(uuid())
  userId      String
  empresaId   String
  clienteId   String?
  motivo      String
  motivoTipo  String
  payloadJson String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, empresaId, createdAt])
}

model EmissaoJob {
  id                    String    @id @default(uuid())
  empresaId             String
  clienteId             String
  vendaId               String?
  actorUserId           String
  billingUserId         String?
  payloadJson           String    @db.Text
  fiscalSnapshotJson    String?   @db.Text
  status                String    @default("PENDENTE")
  statusMessage         String?
  attempts              Int       @default(0)
  maxAttempts           Int       @default(5)
  partitionKey          Int       @default(0)
  idempotencyKey        String
  reservedPlanHistoryId String?
  creditReservationId   String?   @unique
  billingUnlimited      Boolean   @default(false)
  ambiente              String    @default("HOMOLOGACAO")
  transmissionStartedAt DateTime?
  signedXml             String?   @db.Text
  dpsId                 String?
  preparedMetadataJson  String?   @db.Text
  authorizedXmlBase64   String?   @db.Text
  acknowledgedAt        DateTime?
  leaseToken            String?
  leaseUntil            DateTime?
  reservedDpsNumero     Int?
  serieDPS              String?
  lockedAt              DateTime?
  lockedBy              String?
  nextAttemptAt         DateTime?
  startedAt             DateTime?
  finishedAt            DateTime?
  lastError             String?   @db.Text
  resultNotaId          String?
  source                String    @default("WEB")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  creditReservation EmissionCreditReservation? @relation(fields: [creditReservationId], references: [id])
  documentTask      EmissionDocumentTask?

  @@unique([empresaId, idempotencyKey])
  @@index([empresaId, status, createdAt])
  @@index([partitionKey, status, nextAttemptAt])
  @@index([vendaId])
  @@index([status, nextAttemptAt, leaseUntil])
}

model EmissionDocumentTask {
  id            String      @id @default(uuid())
  jobId         String?     @unique
  job           EmissaoJob? @relation(fields: [jobId], references: [id])
  notaId        String      @unique
  nota          NotaFiscal  @relation(fields: [notaId], references: [id])
  revision      Int         @default(1)
  status        String      @default("PENDENTE")
  attempts      Int         @default(0)
  leaseToken    String?
  leaseUntil    DateTime?
  nextAttemptAt DateTime?
  lastError     String?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, nextAttemptAt, leaseUntil])
}

model WorkerHeartbeat {
  id                String   @id
  productionEnabled Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  startedAt         DateTime @default(now())
}

model EmissionRequestBlock {
  id             String   @id @default(uuid())
  empresaId      String
  idempotencyKey String
  actorUserId    String
  createdAt      DateTime @default(now())

  @@unique([empresaId, idempotencyKey])
}

model UserCliente {
  id               String    @id @default(uuid())
  userId           String
  empresaId        String
  apelido          String?
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  revokedBy        String?
  revocationReason String?
  empresa          Empresa   @relation(fields: [empresaId], references: [id])
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, empresaId])
  @@index([empresaId, revokedAt])
}

model Cnae {
  id              String  @id @default(uuid())
  codigo          String
  descricao       String
  principal       Boolean @default(false)
  codigoNbs       String?
  temRetencaoInss Boolean @default(false)
  empresaId       String
  empresa         Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model NotaFiscal {
  id                          String                @id @default(uuid())
  vendaId                     String?
  numero                      Int?
  numeroOficial               String?
  ambiente                    String?
  dataCancelamento            DateTime?
  valor                       Decimal               @db.Decimal(10, 2)
  descricao                   String
  prestadorCnpj               String
  tomadorCnpj                 String
  tomadorNome                 String?
  metadadosVerificadosEm      DateTime?
  status                      StatusNota            @default(RASCUNHO)
  xmlBase64                   String?
  xmlAutorizadoBase64         String?
  xmlCancelamentoEventoBase64 String?
  fiscalSnapshotJson          String?               @db.Text
  pdfBase64                   String?
  chaveAcesso                 String?
  protocolo                   String?
  empresaId                   String
  clienteId                   String
  cnae                        String?
  codigoServico               String?
  dataEmissao                 DateTime?
  createdAt                   DateTime              @default(now())
  arquivadoEm                 DateTime?
  arquivadoPor                String?
  motivoArquivamento          String?
  cliente                     Cliente               @relation(fields: [clienteId, empresaId], references: [id, empresaId])
  empresa                     Empresa               @relation("PrestadorNota", fields: [empresaId], references: [id])
  venda                       Venda?                @relation(fields: [vendaId], references: [id])
  documentTask                EmissionDocumentTask?
  fiscalOperations            FiscalNoteOperation[]

  @@unique([id, empresaId])
