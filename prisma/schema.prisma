// === CRM: Linha do Tempo e Logs de Relacionamento ===
model UserEvent {
  id        String   @id @default(uuid())
  userId    String
  tipo      String // Ex: "SISTEMA", "FINANCEIRO", "MANUAL", "EMAIL_ENVIADO"
  titulo    String // Ex: "Pagamento Recusado", "Anotação de Venda"
  descricao String? // Ex: "O cliente informou que vai pagar amanhã."
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// MÓDULO FINANCEIRO & PAGAMENTOS (PIX INTER)
// ==========================================

model Fatura {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Opcional: Se a fatura for referente à assinatura de um plano principal
  planoId String?
  plan    Plan?   @relation(fields: [planoId], references: [id])

  descricao  String // Resumo do que foi comprado (Ex: "Basic (1x) + 5 Notas Extras")
  valorTotal Decimal @db.Decimal(10, 2) // Valor final pago (já com descontos)

  // Controle Financeiro
  status String @default("PENDENTE") // PENDENTE, PAGO, CANCELADO, VENCIDO
  metodo String @default("PIX")

  // Retorno do Gateway (Banco Inter / Asaas / Stripe)
  txid      String? // ID da transação no banco
  qrCodePix String? @db.Text

  pagoEm    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relação 1 para N (Uma fatura pode ter registado o uso de um cupom)
  cupomLogs CupomLog[]
  pedido    Pedido?

  @@index([userId])
  @@index([status])
  @@index([txid])
}

// ==========================================
// MOTOR DE CUPONS E PARCERIAS
// ==========================================

model Cupom {
  id     String @id @default(uuid())
  codigo String @unique // Ex: VIMDA_A, BEMVINDO50

  // Regras de Desconto
  tipoDesconto  String // 'PORCENTAGEM' ou 'VALOR_FIXO'
  valorDesconto Decimal @db.Decimal(10, 2) // Ex: 50.00 (50%) ou 100.00 (R$ 100)

  // Regras de Escassez
  validade   DateTime? // Expira em (Nulo = Nunca expira)
  limiteUsos Int? // Quantos podem usar no total (Nulo = Infinito)
  vezesUsado Int       @default(0) // Contador automático

  // Regras de Carrinho (As nossas travas inteligentes)
  aplicarEm String @default("CARRINHO_TOTAL") // 'CARRINHO_TOTAL', 'SO_ASSINATURA', 'SO_PACOTES'
  maxCiclos Int? // Trava de meses (Ex: Dá desconto só em até 2 meses de plano)

  // Gestão de Parceiros (Para você pagar comissões)
  parceiroNome String? // Ex: "Escritório Contábil XPTO"

  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relação (Quem usou este cupom)
  logs    CupomLog[]
  pedidos Pedido[]

  // Novas regras avançadas
  planosValidos        String? // Guarda os IDs dos planos selecionados no container
  apenasPrimeiraCompra Boolean @default(false) // Trava para novos clientes

  @@index([codigo])
  @@index([ativo])
}

// O "Histórico" de usos (A Ponte entre Fatura, Cliente e Cupom)
// É aqui que tiramos o relatório para pagar os parceiros no fim do mês!
model CupomLog {
  id String @id @default(uuid())

  cupomId String
  cupom   Cupom  @relation(fields: [cupomId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  faturaId String
  fatura   Fatura @relation(fields: [faturaId], references: [id], onDelete: Cascade)

  // Fotografia do momento da compra
  descontoAplicado Decimal @db.Decimal(10, 2) // Quantos R$ o cliente economizou nesta fatura

  createdAt DateTime @default(now())

  @@index([cupomId])
  @@index([userId])
  @@index([faturaId])
}

// Immutable proposal; it grants no company access until all gates commit together.
model CompanyOwnershipRequest {
  id                      String                    @id @default(uuid())
  empresaId               String
  initiatorId             String
  proposedOwnerId         String
  previousOwnerId         String?
  previousPrimaryUserId   String?
  mode                    String
  status                  String                    @default("PENDING")
  termsVersion            String
  ownershipSnapshotJson   String                    @db.Text
  snapshotHash            String
  caseTicketId            String
  evidenceMessageId       String
  evidenceHash            String
  justification           String                    @db.Text
  reviewerId              String?
  reviewEvidenceMessageId String?
  reviewEvidenceHash      String?
  resolutionJustification String?
  resolvedById            String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  expiresAt               DateTime
  finishedAt              DateTime?
  empresa                 Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  initiator               User                      @relation("OwnershipInitiator", fields: [initiatorId], references: [id], onDelete: Restrict)
  proposedOwner           User                      @relation("OwnershipRecipient", fields: [proposedOwnerId], references: [id], onDelete: Restrict)
  previousOwner           User?                     @relation("OwnershipPrevious", fields: [previousOwnerId], references: [id], onDelete: Restrict)
  previousPrimaryUser     User?                     @relation("OwnershipPrimary", fields: [previousPrimaryUserId], references: [id], onDelete: Restrict)
  reviewer                User?                     @relation("OwnershipReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  caseTicket              Ticket                    @relation(fields: [caseTicketId], references: [id], onDelete: Restrict)
  consents                CompanyOwnershipConsent[]

  @@index([empresaId, status, createdAt])
  @@index([proposedOwnerId, status, createdAt])
  @@index([previousOwnerId, status, createdAt])
  @@index([previousPrimaryUserId, status, createdAt])
  @@index([status, expiresAt])
}

model CompanyOwnershipConsent {
  id             String                  @id @default(uuid())
  requestId      String
  userId         String
  sessionVersion Int
  termsHash      String
  acceptedAt     DateTime                @default(now())
  request        CompanyOwnershipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([requestId, userId])
  @@index([userId])
}
