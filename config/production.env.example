# Modelo sem segredos. Copie os nomes para o cofre de segredos da hospedagem.
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.exemplo.com.br
JWT_SECRET=GERAR_UM_SEGREDO_ALEATORIO_FORTE_COM_32_OU_MAIS_CARACTERES
ENCRYPTION_KEY=GERAR_32_BYTES_ALEATORIOS_AQUI!!
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=verify-full
# Manifesto gerado depois do build web e da compilação dos workers.
RELEASE_MANIFEST_FILE=/opt/nfsegoo/dist/release-manifest.json
# Evidência operacional aprovada, protegida e fora do release público.
INFRASTRUCTURE_EVIDENCE_FILE=/etc/nfsegoo/infrastructure.json
# Evidência jurídica aprovada e vinculada ao conteúdo deste release.
LEGAL_GOVERNANCE_EVIDENCE_FILE=/etc/nfsegoo/legal-governance.json
# Relatório aprovado de carga/recuperação executado contra este mesmo release.
CAPACITY_EVIDENCE_FILE=/etc/nfsegoo/capacity-evidence.json
# Resultado integral do roteiro manual, aprovado para o mesmo release candidato.
MANUAL_ACCEPTANCE_EVIDENCE_FILE=/etc/nfsegoo/manual-acceptance-evidence.json
# Monitor externo usa o domínio público; o probe interno também confere banco e filas.
MONITOR_TARGET_BASE_URL=https://app.exemplo.com.br
MONITORING_PROVIDER_REF=provedor-uptime/monitor-principal
MONITORING_ALERT_OWNER=equipe-operacao
MONITORING_ALERT_CHANNEL_REF=oncall/operacao
MONITORING_RUNBOOK_REF=runbook/operacao

SECURITY_HSTS_ENABLED=true
TRUST_PROXY_HEADERS=true
TRUSTED_CLIENT_IP_HEADER=x-real-ip
TRUST_PROXY_HOPS=1
CSRF_ALLOWED_ORIGINS=https://app.exemplo.com.br

FISCAL_WORKER_ALLOW_PRODUCTION=true
FISCAL_HOMOLOGATION_ENFORCEMENT=true
# Arquivo JSON aprovado, protegido e fora do diretório público/repositório.
FISCAL_HOMOLOGATION_EVIDENCE_FILE=/etc/nfsegoo/fiscal-homologation.json
EMAIL_OUTBOX_ENABLED=true
READINESS_REQUIRE_WORKER=true
READINESS_REQUIRE_PRODUCTION_WORKER=true
READINESS_REQUIRE_CONSULTATION_WORKER=true
READINESS_REQUIRE_DOCUMENT_WORKER=true
EMISSION_WORKER_CONCURRENCY=2
# Raízes públicas v5/v12 verificadas do ITI estão em resources/fiscal/icp-brasil-roots-20260826.pem.
# Opcional: substitua/atualize pelo conteúdo PEM aprovado no cofre ou por arquivo absoluto.
# Nunca use o PFX privado da empresa como bundle de confiança.
# ICP_BRASIL_TRUST_BUNDLE_PEM=conteudo-pem-aprovado
# ICP_BRASIL_TRUST_BUNDLE_FILE=/etc/nfsegoo/icp-brasil-roots.pem
# Por padrão, a aplicação usa o pacote oficial versionado em resources/fiscal.
# Autoridades intermediárias oficiais do ITI, usadas somente para montar a cadeia.
# ICP_BRASIL_INTERMEDIATE_BUNDLE_FILE=/etc/nfsegoo/icp-brasil-intermediates.pem

BILLING_MODE=MANUAL
# O piloto inicial usa somente a base acompanhada. OPEN exige nova decisão de lançamento.
PUBLIC_REGISTRATION_MODE=CLOSED
# CONTROLLED_PILOT exige CLOSED. PUBLIC exige OPEN e evidência de saída do piloto.
LAUNCH_STAGE=CONTROLLED_PILOT
PUBLIC_LAUNCH_EVIDENCE_FILE=/etc/nfsegoo/public-launch-evidence.json
MANUAL_BILLING_OWNER_EMAIL=financeiro@exemplo.com.br
INCIDENT_RESPONSE_OWNER=nome-ou-equipe-responsavel
BACKUP_POLICY_CONFIRMED=true
BACKUP_RESTORE_TESTED_AT=AAAA-MM-DD

NEXT_PUBLIC_LEGAL_COMPANY_NAME=Razao Social Completa Ltda
NEXT_PUBLIC_LEGAL_COMPANY_CNPJ=00.000.000/0001-00
NEXT_PUBLIC_LEGAL_COMPANY_ADDRESS=Endereco completo do controlador
NEXT_PUBLIC_PRIVACY_OFFICER_NAME=Nome do encarregado ou canal formal
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacidade@exemplo.com.br
NEXT_PUBLIC_SUPPORT_CONTACT_EMAIL=suporte@exemplo.com.br
NEXT_PUBLIC_TERMS_VERSION=terms-AAAA-MM-DD-v1
NEXT_PUBLIC_PRIVACY_VERSION=privacy-AAAA-MM-DD-v1
NEXT_PUBLIC_LEGAL_UPDATED_AT=DD de mes de AAAA
NEXT_PUBLIC_LEGAL_DOCUMENTS_APPROVED=true

# SMTP pode ser configurado pelo painel administrativo. Se for por ambiente:
# SMTP_HOST=smtp.exemplo.com.br
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=segredo
# SMTP_FROM=nao-responda@exemplo.com.br

# Devem permanecer ausentes ou false em producao:
ENABLE_MAINTENANCE_ROUTES=false
ENABLE_CERT_DEBUG=false
ALLOW_STATIC_LEGACY_KEY=false
ALLOW_PLAINTEXT_LEGACY_SECRETS=false
